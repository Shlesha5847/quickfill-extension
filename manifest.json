{
  "manifest_version": 3,
  "name": "QuickFill Palette",
  "version": "1.0",
  "description": "Command palette to autofill anything",
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "open-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space"
      },
      "description": "Open Autofill Palette"
    }
  }
}